[Unit]
Description=Rift Manager match simulation worker
After=network.target rift-manager.service
[Service]
User=riftmanager
Group=riftmanager
Environment=RIFT_DB=/var/lib/rift-manager/server.db
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rift-manager/.venv/bin/python /opt/rift-manager/server/match_worker.py --engine /opt/rift-manager/engine
Restart=on-failure
RestartSec=3
Nice=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rift-manager
[Install]
WantedBy=multi-user.target
