[Unit]
Description=Rift Manager local API
After=network.target
[Service]
Type=simple
User=riftmanager
Group=riftmanager
WorkingDirectory=/opt/rift-manager
Environment=RIFT_DB=/var/lib/rift-manager/server.db
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RIFT_PORT=8770
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rift-manager/.venv/bin/python /opt/rift-manager/server/server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rift-manager
[Install]
WantedBy=multi-user.target
