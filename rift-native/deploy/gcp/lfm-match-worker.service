[Unit]
Description=Rift Manager match simulation worker
After=network.target lfm-api.service
[Service]
User=lfm
Group=lfm
Environment=RIFT_DB=/var/lib/lfm/server.db
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lfm/.venv/bin/python /opt/lfm/server/match_worker.py --engine /opt/lfm/engine
Restart=on-failure
RestartSec=3
Nice=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lfm
[Install]
WantedBy=multi-user.target
